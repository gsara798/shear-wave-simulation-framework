{
  "schema_version": "1.1",
  "backend": "swsynth",
  "campaign_name": "example_swsynth_campaign",
  "base_config": "examples/swsynth/campaign/base_config.json",
  "output": {
    "directory": "outputs"
  },
  "sweep": [
    {
      "path": "medium.background_cs_m_s",
      "values": [2.0, 3.0]
    },
    {
      "path": "wavefield.frequency_hz",
      "values": [300, 500]
    },
    {
      "path": "directions.count",
      "values": [1, 8]
    },
    {
      "path": "seed",
      "values": [7001, 7002]
    }
  ]
}
